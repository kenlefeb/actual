<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Kept out of the file; fork-mac-native-testflight.yml sets it from the APPLE_TEAM_ID secret on a copy. -->
	<key>teamID</key>
	<string>SET-BY-THE-WORKFLOW</string>
	<!-- Marks the build "TestFlight Internal Only", so it can never reach external testers. -->
	<key>testFlightInternalTestingOnly</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
